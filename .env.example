# Deployer wallet (never commit real keys)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# mainnet | testnet (default: testnet)
RH_NETWORK=testnet

# Override RPC (defaults to Robinhood Chain URLs in hardhat.config.ts)
# RH_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Token creation defaults (optional — CLI args override these)
TOKEN_NAME=My Token
TOKEN_SYMBOL=MTK
TOKEN_SUPPLY=1000000
TOKEN_OWNER=0xYourWalletAddress

# For mint script
TOKEN_ADDRESS=0xDeployedTokenAddress
MINT_TO=0xRecipientAddress
MINT_AMOUNT=1000
